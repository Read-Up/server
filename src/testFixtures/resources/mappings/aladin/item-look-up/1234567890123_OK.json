{
  "request": {
    "method": "GET",
    "urlPath": "/ItemLookUp.aspx",
    "queryParameters": {
      "TTBKey": {
        "matches": "ttbtestkey20251234567"
      },
      "ItemId": {
        "matches": "1234567890123"
      },
      "ItemIdType": {
        "matches": "ISBN13"
      },
      "Output": {
        "matches": "JS"
      }
    }
  },
  "response": {
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "status": 200,
    "jsonBody": {
      "errorCode": 8,
      "errorMessage": "키에 해당하는 상품이 존재하지 않습니다."
    }
  }
}